# Normalise to LF in the repository and on checkout, on every platform, so golden files
# compare byte for byte on Windows and Linux runners.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never touch. Byte-exact fixtures break silently under line-ending conversion.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.tif   binary
*.tiff  binary
*.dng   binary
*.ico   binary
*.icns  binary
*.wav   binary
*.flac  binary
*.mp3   binary
*.ogg   binary
*.fcs   binary
*.pdf   binary
*.epub  binary
*.docx  binary
*.xlsx  binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.wasm  binary
*.onnx  binary

# Generated: collapse in review
package-lock.json linguist-generated=true
Cargo.lock        linguist-generated=true
uv.lock           linguist-generated=true
THIRD_PARTY.md    linguist-generated=true
